# ==============================================================================
# TUITION MANAGER - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite - Safe to expose in client bundle)
# ------------------------------------------------------------------------------
# Optional: Set this ONLY if your backend is deployed on a separate domain (e.g. Render/Railway/VPS).
# When deploying both frontend and backend on Vercel together, LEAVE THIS EMPTY.
# Example: https://tuition-api.yourdomain.com
VITE_API_URL=

# ------------------------------------------------------------------------------
# BACKEND SECRETS (Server-side ONLY - NEVER prefix with VITE_)
# ------------------------------------------------------------------------------
# Secret key used for cryptographic session token generation and verification
JWT_SECRET=your_jwt_secret_key_here

# Resend API Key for sending real transactional emails (verification codes, password reset)
# If left empty, verification codes are logged to console and stored in dev mailbox
RESEND_API_KEY=

# Sender email for transactional emails
EMAIL_FROM=Tuition Manager <noreply@tuitionmanager.vn>

# Standalone backend server port (default: 3000)
PORT=3000
